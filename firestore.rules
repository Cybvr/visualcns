rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function agencyId() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('agencyId', ''); }
    function sameAgency(data) { return signedIn() && agencyId() != '' && data.get('agencyId', '') == agencyId(); }
    function isSuperAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
    function agencyAdmin(data) { return isAdmin() && (isSuperAdmin() || sameAgency(data)); }
    function companyId() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId; }
    function owns(data) { return sameAgency(data) && data.get('companyId', '') == companyId(); }
    function pendingSelfCreate(uid) {
      return signedIn() && request.auth.uid == uid
        && request.resource.data.get('onboardingStatus', '') == 'pending-invite'
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'updatedAt', 'onboardingStatus']);
    }
    function pendingSelfUpdate(uid) {
      return signedIn() && request.auth.uid == uid
        && resource.data.get('onboardingStatus', '') == 'pending-invite'
        && request.resource.data.get('onboardingStatus', '') == 'pending-invite'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
    }
    function pendingSelfClaim(uid) {
      return signedIn() && request.auth.uid == uid
        && resource.data.get('onboardingStatus', '') == 'pending-invite'
        && resource.data.get('role', '') == ''
        && resource.data.get('agencyId', '') == ''
        && request.resource.data.role == 'admin'
        && request.resource.data.agencyId == uid
        && request.resource.data.companyId == uid
        && request.resource.data.onboardingStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'updatedAt', 'role', 'agencyId',
          'companyId', 'company', 'slug', 'onboardingStatus', 'welcomeEmailPending'
        ]);
    }

    match /portfolio/{id} { allow read: if true; allow write: if isAdmin(); }
    match /jpportfolio/{id} { allow read: if true; allow write: if isAdmin(); }
    match /agencies/{id} {
      allow read: if isSuperAdmin() || (signedIn() && id == agencyId());
      allow create: if isAdmin() && id == agencyId();
      allow update: if isSuperAdmin() || (isAdmin() && id == agencyId());
      allow delete: if isSuperAdmin();
    }
    match /organizations/{id} {
      allow read: if agencyAdmin(resource.data) || resource.data.get('publicVisible', false) == true;
      allow create: if agencyAdmin(request.resource.data) || (isAdmin() && request.resource.data.agencyId == agencyId());
      allow update: if agencyAdmin(resource.data) && request.resource.data.agencyId == resource.data.get('agencyId', agencyId());
      allow delete: if agencyAdmin(resource.data);
    }
    match /settings/{id} {
      allow read: if agencyAdmin(resource.data);
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }

    match /users/{uid} {
      allow read: if agencyAdmin(resource.data) || (signedIn() && request.auth.uid == uid);
      allow create: if (isAdmin() && request.resource.data.agencyId == agencyId()) || (signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['admin', 'client'] && request.resource.data.companyId == uid
        && request.resource.data.agencyId == request.auth.uid) || pendingSelfCreate(uid);
      allow update: if agencyAdmin(resource.data) || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.agencyId == resource.data.get('agencyId', agencyId())
        && request.resource.data.companyId == resource.data.get('companyId', uid)) || pendingSelfUpdate(uid) || pendingSelfClaim(uid);
      allow delete: if agencyAdmin(resource.data);
    }

    // Agency source documents stay private, apart from existing marketing publications.
    match /projects/{id} {
      // Readable by anyone, so the public company page can show every project in full.
      allow read: if true;
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }
    // Front-desk visitors. Created only by /api/visitors; the agency and the
    // client's own staff can read them and sign someone out.
    match /visitors/{id} {
      allow read: if agencyAdmin(resource.data) || owns(resource.data);
      allow update: if (agencyAdmin(resource.data) || owns(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedOutAt', 'updatedAt'])
        && request.resource.data.status == 'signed_out';
      allow delete: if agencyAdmin(resource.data);
    }
    // The tablet link for each company, keyed by companyId.
    match /visitorKiosks/{companyId} {
      allow read: if agencyAdmin(resource.data) || owns(resource.data);
      allow create, update: if (isAdmin() && (isSuperAdmin() || sameAgency(request.resource.data)))
        || (owns(request.resource.data) && request.resource.data.companyId == companyId);
      allow delete: if agencyAdmin(resource.data);
    }
    // Trial and Paystack subscription per site. Written only by the server.
    match /visitorBilling/{companyId} {
      // A missing record reads as empty, so the dashboard keeps listening until the trial starts.
      allow read: if signedIn() && (resource == null || agencyAdmin(resource.data) || owns(resource.data));
      allow write: if false;
    }
    // Phone QR key, visitor agreement and Slack/Teams/webhook addresses.
    // Read and written only by /api/visitors/settings.
    match /visitorSettings/{companyId} {
      allow read, write: if false;
    }
    match /tasks/{id} {
      // Readable by anyone, so the public company page can show every task in full.
      allow read: if true;
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
      allow update: if agencyAdmin(resource.data);
    }

    // Creators booked on a campaign. Readable by anyone, like the campaign itself.
    // The client's own people can add a suggested creator to the roster or take one off.
    match /campaignPeople/{id} {
      allow read: if true;
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if (agencyAdmin(resource.data) && sameAgency(request.resource.data))
        || (owns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onRoster', 'updatedAt']));
      allow delete: if agencyAdmin(resource.data);
    }

    // Posts, artwork, videos and links made for a campaign. Readable by anyone, like the campaign itself.
    // The client's own people can suggest a written post, edit post text and approve or send it back.
    match /campaignCreatives/{id} {
      allow read: if true;
      allow create: if (isAdmin() && sameAgency(request.resource.data))
        || (owns(request.resource.data) && request.resource.data.type == 'text' && request.resource.data.status == 'Draft');
      allow update: if (agencyAdmin(resource.data) && sameAgency(request.resource.data))
        || (owns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'body', 'updatedAt'])
          && request.resource.data.status in ['Draft', 'Ready for your review', 'Changes requested', 'Approved', 'In review', 'Changes needed']);
      allow delete: if agencyAdmin(resource.data);
    }

    // Task discussions are agency notes.
    match /comments/{id} {
      allow read: if agencyAdmin(resource.data);
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }
    // The shared conversation between a company's people and the agency.
    match /companyMessages/{id} {
      allow read: if agencyAdmin(resource.data) || owns(resource.data);
      allow create: if (agencyAdmin(request.resource.data) || owns(request.resource.data))
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.side in ['agency', 'company'];
      allow update: if false;
      allow delete: if agencyAdmin(resource.data);
    }
    match /documents/{id} {
      allow read: if agencyAdmin(resource.data) || owns(resource.data)
        || (signedIn() && request.auth.uid in resource.data.get('sharedWithUserIds', []));
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }

    match /emailMessages/{id} {
      allow read: if agencyAdmin(resource.data) || owns(resource.data);
      allow create: if (isAdmin() && sameAgency(request.resource.data)) || (owns(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id', 'companyId', 'createdBy', 'providerId', 'to', 'subject',
          'agencyId',
          'createdAt', 'from', 'replyTo', 'bodyHtml', 'bodyText', 'recipients',
          'projectId', 'projectName', 'documentType', 'documentId', 'documentTitle',
          'companyName', 'messageKind', 'status', 'scheduledAt', 'trashedAt', 'cc'
        ])
        && request.resource.data.id == id
        && request.resource.data.providerId is string
        && request.resource.data.to is string
        && request.resource.data.subject is string
        && request.resource.data.createdAt is string);
      allow update: if (agencyAdmin(resource.data) && sameAgency(request.resource.data))
        || (owns(resource.data) && resource.data.createdBy == request.auth.uid
          && sameAgency(request.resource.data)
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trashedAt']));
      allow delete: if agencyAdmin(resource.data) || (owns(resource.data) && resource.data.createdBy == request.auth.uid);
    }

    match /emailLists/{id} {
      allow read: if agencyAdmin(resource.data);
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }

    // A compose-in-progress belongs to the person who started it, scoped by
    // companyId like the sent messages. Admins can reach the whole team's drafts.
    match /emailDrafts/{id} {
      allow read: if agencyAdmin(resource.data) || (owns(resource.data) && resource.data.createdBy == request.auth.uid);
      allow create: if (isAdmin() && sameAgency(request.resource.data)) || (owns(request.resource.data) && request.resource.data.createdBy == request.auth.uid);
      allow update: if (agencyAdmin(resource.data) && sameAgency(request.resource.data)) || (owns(request.resource.data) && request.resource.data.createdBy == request.auth.uid);
      allow delete: if agencyAdmin(resource.data) || (owns(resource.data) && resource.data.createdBy == request.auth.uid);
    }

    // Notes without a companyId are shared across the agency. Company notes are
    // limited to that company's people and the agency admins who manage them.
    // A shared note can be opened by anyone with its link, read only.
    match /notes/{id} {
      allow get: if resource.data.get('shareEnabled', false) == true;
      allow read, delete: if sameAgency(resource.data)
        && (resource.data.get('companyId', '') == '' || agencyAdmin(resource.data) || owns(resource.data));
      allow create: if sameAgency(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.get('companyId', '') == '' || agencyAdmin(request.resource.data) || owns(request.resource.data));
      allow update: if sameAgency(resource.data) && sameAgency(request.resource.data)
        && request.resource.data.agencyId == resource.data.agencyId
        && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
        && (resource.data.get('companyId', '') == '' || agencyAdmin(resource.data) || owns(resource.data))
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // Sales pipeline. Agency admins only; a lead is not a user or client until won.
    match /leads/{id} {
      allow read, delete: if agencyAdmin(resource.data);
      allow create: if isAdmin() && sameAgency(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data)
        && request.resource.data.agencyId == resource.data.agencyId
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // Immutable audit entries for task and lead status transitions.
    match /statusEvents/{id} {
      allow read: if agencyAdmin(resource.data);
      allow create: if isAdmin() && sameAgency(request.resource.data)
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.entityType in ['task', 'lead']
        && request.resource.data.entityId is string
        && request.resource.data.fromStatus is string
        && request.resource.data.toStatus is string;
      allow update, delete: if false;
    }

    match /hiddenReceivedEmails/{id} {
      allow read: if agencyAdmin(resource.data) || owns(resource.data);
      allow create: if (isAdmin() && sameAgency(request.resource.data))
        || (owns(request.resource.data) && request.resource.data.createdBy == request.auth.uid);
      allow update: if (agencyAdmin(resource.data) || owns(resource.data))
        && sameAgency(request.resource.data)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trashedAt', 'message', 'hiddenAt']);
      allow delete: if agencyAdmin(resource.data) || owns(resource.data);
    }

    // Email is an agency tool: agency admins can manage templates for every company in their agency.
    match /emailTemplates/{id} {
      allow read: if agencyAdmin(resource.data);
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }

    // Marketing unsubscribe records are written and read only by server routes
    // using the Firebase Admin SDK. No browser client can alter suppression.
    match /emailUnsubscriptions/{id} {
      allow read, write: if false;
    }
    match /invites/{id} { allow read, write: if false; }
    match /agencySecrets/{id} { allow read, write: if false; }
    match /agencyUsage/{id} { allow read, write: if false; }
    // Social accounts, inbox and webhook receipts go through /api/social only.
    match /socialAccounts/{id} { allow read, write: if false; }
    match /socialInbox/{id} { allow read, write: if false; }
    match /socialWebhookDeliveries/{id} { allow read, write: if false; }
    // Agent operations are surfaced through server routes so raw prompts and
    // tool metadata never become browser-readable by default.
    match /agentRuns/{id} {
      allow read: if agencyAdmin(resource.data);
      allow write: if false;
      match /events/{eventId} { allow read: if agencyAdmin(get(/databases/$(database)/documents/agentRuns/$(id)).data); allow write: if false; }
    }
    match /agentAdoptionEvents/{id} { allow read, write: if false; }
    match /agentJobs/{id} { allow read, write: if false; }
    match /agentMemories/{id} {
      allow read: if agencyAdmin(resource.data);
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }

    // Keep legacy single-document links. Anonymous collection browsing is closed.
    match /invoices/{id} {
      allow get: if agencyAdmin(resource.data) || resource.data.status != 'draft';
      allow list: if agencyAdmin(resource.data) || resource.data.status != 'draft';
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }
    match /contracts/{id} {
      allow get: if agencyAdmin(resource.data) || resource.data.status != 'draft';
      allow list: if agencyAdmin(resource.data) || resource.data.status != 'draft';
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }
    match /estimates/{id} {
      allow get: if agencyAdmin(resource.data) || (resource.data.status != 'draft' && (owns(resource.data) || resource.data.get('shareEnabled', false) == true));
      allow list: if agencyAdmin(resource.data) || (resource.data.status != 'draft' && resource.data.get('shareEnabled', false) == true)
        || (owns(resource.data) && resource.data.status != 'draft');
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
      allow update: if agencyAdmin(resource.data) || ((owns(resource.data) || resource.data.get('shareEnabled', false) == true)
        && resource.data.status == 'sent' && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'updatedAt']));
    }
    // Written documents sent to a company: proposals, statements of work,
    // briefs. Drafts stay internal; a sent document is readable by its own
    // company, or by anyone holding the link once sharing is turned on.
    match /companyDocuments/{id} {
      // Public is the visibility switch: a public document reaches the client and the
      // no-account share link whatever its draft status. Non-public documents only ever
      // reach their own client once sent.
      allow get: if agencyAdmin(resource.data) || resource.data.get('shareEnabled', false) == true || (owns(resource.data) && resource.data.status != 'draft');
      allow list: if agencyAdmin(resource.data)
        || resource.data.get('shareEnabled', false) == true
        || (owns(resource.data) && resource.data.get('shareEnabled', false) == true);
      allow create: if isAdmin() && sameAgency(request.resource.data);
      allow update: if agencyAdmin(resource.data) && sameAgency(request.resource.data);
      allow delete: if agencyAdmin(resource.data);
    }

    // One conversation transcript per signed-in account. The agent stores no
    // portal records here; this is only the user's own chat history.
    match /agentConversations/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /chats/{chatId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
